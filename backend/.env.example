# MongoDB connection string used by the backend.
MONGO_URI=your_mongodb_connection_string_here

# Database name used inside MongoDB.
DATABASE_NAME=dhakanest_db

# JWT settings used for login tokens. Put the real secret only in .env.
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary credentials. Keep real values only in backend/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Limits applied to listing image uploads.
LISTING_IMAGE_MAX_COUNT=8
LISTING_IMAGE_MAX_SIZE_MB=5
