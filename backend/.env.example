# MongoDB connection string used by the backend.
APP_ENV=development
APP_VERSION=0.1.0
BUILD_COMMIT=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

MONGO_URI=your_mongodb_connection_string_here

# Database name used inside MongoDB.
DATABASE_NAME=dhakanest_db

# JWT settings used for login tokens. Put the real secret only in .env.
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary credentials. Keep real values only in backend/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Limits applied to listing image uploads.
LISTING_IMAGE_MAX_COUNT=8
LISTING_IMAGE_MAX_SIZE_MB=5

# Development road-routing configuration. No API key is required for OSRM.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10
ROUTING_USER_AGENT=DhakaNest-University-Development/0.1
ROUTING_FALLBACK_PROVIDER=
ROUTING_FALLBACK_BASE_URL=
ROUTING_MAX_RETRIES=1
ROUTING_RETRY_BACKOFF_SECONDS=0.15
ROUTING_MATRIX_CACHE_TTL_SECONDS=900
ROUTING_GEOMETRY_CACHE_TTL_SECONDS=3600
ROUTING_CACHE_MAX_ENTRIES=1000
ROUTING_CACHE_COORDINATE_PRECISION=6
ROUTING_MATRIX_LISTING_BATCH_SIZE=75
ROUTING_CIRCUIT_FAILURE_THRESHOLD=3
ROUTING_CIRCUIT_OPEN_SECONDS=30
ROUTING_HEALTH_CACHE_TTL_SECONDS=30
RECOMMENDATION_RATE_LIMIT_PER_MINUTE=12
ROUTE_GEOMETRY_RATE_LIMIT_PER_MINUTE=30

# Local academic travel-cost assumption; replace if your research adopts another rate.
TRANSPORT_COST_PER_KM_BDT=15

# Configurable nearest-property candidate count for Recommendation Part 4.
RECOMMENDATION_KNN_K=10
